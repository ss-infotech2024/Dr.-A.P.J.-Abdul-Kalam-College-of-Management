    <style>
        /* Base Styles */
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }
        
        .careers-section {
            max-width: 1200px;
            margin: 0 auto;
            padding: 80px 20px;
        }
        
        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }
        
        .section-header h2 {
            font-size: 2.5rem;
            color: #2c3e50;
            margin-bottom: 15px;
        }
        
        .section-header p {
            font-size: 1.1rem;
            color: #7f8c8d;
            max-width: 700px;
            margin: 0 auto;
        }
        /* Filter Controls */
        
        .filter-controls {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 40px;
        }
        
        .filter-btn {
            padding: 10px 20px;
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        
        .filter-btn:hover {
            background-color: #f1f2f6;
        }
        
        .filter-btn.active {
            background-color: #22765e;
            color: white;
            border-color: #c5c515;
        }
        /* Job Listings */
        
        .job-listings {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
        }
        
        .job-card {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            padding: 30px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        
        .job-category {
            position: absolute;
            top: 0;
            right: 0;
            background-color: #22765e;
            color: white;
            padding: 5px 15px;
            font-size: 0.8rem;
            border-bottom-left-radius: 10px;
        }
        
        .job-title {
            font-size: 1.4rem;
            color: #2c3e50;
            margin-bottom: 10px;
        }
        
        .job-location {
            color: #7f8c8d;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
        }
        
        .job-location i {
            margin-right: 5px;
        }
        
        .job-description {
            color: #5a6c7d;
            margin-bottom: 20px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .job-meta {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }
        
        .job-type {
            background-color: #e8f4fc;
            color: #22765e;
            padding: 5px 10px;
            border-radius: 20px;
        }
        
        .job-salary {
            color: #27ae60;
            font-weight: 600;
        }
        
        .apply-btn {
            display: block;
            width: 100%;
            padding: 12px;
            background-color: #22765e;
            color: white;
            border: none;
            border-radius: 5px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s ease;
            text-align: center;
            text-decoration: none;
        }
        
        .apply-btn:hover {
            background-color: #e4c606;
        }
        
        .no-jobs {
            grid-column: 1 / -1;
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
        }
        /* Responsive Design */
        
        @media (max-width: 768px) {
            .job-listings {
                grid-template-columns: 1fr;
            }
            .section-header h2 {
                font-size: 2rem;
            }
        }
        
        .download-container {
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        
        h2 {
            color: #333;
            margin-bottom: 30px;
        }
        
        .buttons-container {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .download-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }
        /* First Button Style */
        
        .btn-primary {
            background-color: #007bff;
            color: white;
        }
        
        .btn-primary:hover {
            background-color: #0056b3;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 123, 255, 0.3);
        }
        /* Second Button Style */
        
        .btn-secondary {
            background-color: #28a745;
            color: white;
        }
        
        .btn-secondary:hover {
            background-color: #1e7e34;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(40, 167, 69, 0.3);
        }
        
        .btn-icon {
            width: 20px;
            height: 20px;
        }
        /* Responsive Design */
        
        @media (max-width: 480px) {
            .buttons-container {
                flex-direction: column;
                align-items: center;
            }
            .download-btn {
                width: 200px;
                justify-content: center;
            }
        }
        /* cards */
        /* fees structure */
        
        .year-fees {
            padding: 50px 20px;
            text-align: center;
            background: #f8fafc;
        }
        
        .year-fees h2 {
            font-size: 28px;
            margin-bottom: 30px;
            color: #1e3c72;
        }
        
        .year-fees-box {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        
        .year-fees-card {
            background: #ffffff;
            width: 280px;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
            transition: 0.3s ease;
        }
        
        .year-fees-card:hover {
            transform: translateY(-8px);
        }
        
        .year-fees-card h3 {
            font-size: 22px;
            margin-bottom: 10px;
            color: #333;
        }
        
        .year-fees-card p {
            font-size: 14px;
            margin-bottom: 18px;
            color: #666;
        }
        
        .year-fees-card a {
            text-decoration: none;
            background: #1e3c72;
            color: white;
            padding: 10px 20px;
            border-radius: 6px;
            font-size: 14px;
            transition: 0.3s;
        }
        
        .year-fees-card a:hover {
            background: #2a5298;
        }
    </style>

</head>

